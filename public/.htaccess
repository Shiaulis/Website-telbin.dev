# Serve the site's own 404 page for missing URLs (keeps the 404 status code)
ErrorDocument 404 /404.html

# Send www.telbin.dev to the canonical https://telbin.dev (same path and query string)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.telbin\.dev$ [NC]
  RewriteRule ^ https://telbin.dev%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # HSTS: cautious 1-day start, no includeSubDomains, no preload.
  # Raise max-age to 31536000 (1 year) once this has been live without problems.
  Header always set Strict-Transport-Security "max-age=86400"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Content-Security-Policy, part 1 of 2. Astro adds part 2 (default-src, script/style hashes, img-src...)
  # as a <meta> tag on every page; see security.csp in astro.config.mjs. Browsers enforce both.
  # Never add default-src, script-src or style-src here: a header can't carry the per-build hashes,
  # so it would block the site's inline scripts and styles.
  Header always set Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"

  # HTML pages, rss.xml and sitemaps keep the same URL across deploys: make browsers check for a
  # newer version on every visit (a cheap 304 when nothing changed) instead of guessing a lifetime
  # and showing a stale page that points at deleted /_astro/ files. Never matches /_astro/ files.
  <FilesMatch "\.(html|xml)$">
    Header always set Cache-Control "no-cache"
  </FilesMatch>

  # Astro's /_astro/ files have content hashes in their names, so they never change: cache for a year.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
