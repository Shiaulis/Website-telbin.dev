---
import { getImage } from 'astro:assets';
import ogBanner from '../assets/og-banner.png';

interface Props {
	title?: string;
	description?: string;
	/** Shorter title for link previews (og:title / twitter:title). Defaults to `title`. */
	socialTitle?: string;
	image?: string;
	imageAlt?: string;
	/** Pixel size of a custom `image`; the default banner is always 1200x630. */
	imageWidth?: number;
	imageHeight?: number;
	type?: 'website' | 'article';
	noindex?: boolean;
	publishedTime?: Date;
	modifiedTime?: Date;
}

const {
	title = "Andrius Shiaulis | Senior Software Engineer & AI Workflow Advisor",
	description = "Senior Software Engineer and Technical Advisor with 11+ years in tech (Pipedrive, Readdle), helping individuals and teams bring practical AI tools, custom agent workflows, and resilient architecture into daily work.",
	socialTitle,
	image,
	imageAlt: imageAltProp,
	imageWidth,
	imageHeight,
	type = "website",
	noindex = false,
	publishedTime,
	modifiedTime,
} = Astro.props;

const siteURL = Astro.site ?? new URL('https://telbin.dev');
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const defaultImage = image ? undefined : await getImage({
	src: ogBanner,
	width: 1200,
	height: 630,
	format: 'png',
});
const imageURL = new URL(image ?? defaultImage!.src, siteURL);
const ogTitle = socialTitle ?? title;
const imageAlt = imageAltProp ?? (image
	? ogTitle
	: "Andrius Shiaulis — Senior Software Engineer & AI Workflow Advisor, telbin.dev");
const ogImageWidth = image ? imageWidth : 1200;
const ogImageHeight = image ? imageHeight : 630;

// Structured data (JSON-LD) for search engines: who the site is about, and article details on blog posts.
const homeURL = new URL('/', siteURL).href;
const person = {
	'@type': 'Person',
	'@id': `${homeURL}#person`,
	name: 'Andrius Shiaulis',
	url: homeURL,
	jobTitle: 'Senior Software Engineer & AI Workflow Advisor',
	sameAs: ['https://linkedin.com/in/shiaulis/', 'https://github.com/shiaulis', 'https://x.com/shiaulis'],
};
const pathname = Astro.url.pathname.replace(/\/?$/, '/');
let structuredData: Record<string, unknown> | undefined;
if (type === 'article') {
	structuredData = {
		'@context': 'https://schema.org',
		'@type': 'BlogPosting',
		headline: ogTitle,
		description,
		image: imageURL.href,
		url: canonicalURL.href,
		mainEntityOfPage: canonicalURL.href,
		datePublished: publishedTime?.toISOString(),
		dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
		author: person,
		publisher: { '@id': person['@id'] },
	};
} else if (pathname === '/') {
	structuredData = {
		'@context': 'https://schema.org',
		'@graph': [
			{ '@type': 'WebSite', name: 'Andrius Shiaulis', url: homeURL, publisher: { '@id': person['@id'] } },
			person,
		],
	};
} else if (pathname === '/about/') {
	structuredData = {
		'@context': 'https://schema.org',
		'@type': 'ProfilePage',
		url: canonicalURL.href,
		mainEntity: person,
	};
}
// Escape "<" so post text can never close the <script> tag early.
const structuredDataJSON = structuredData && JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">

	<title>{title}</title>
	<meta name="description" content={description}>
	<meta name="keywords" content="Senior Software Engineer, AI Workflow Advisor, Technical Advisor, Software Architecture, AI Agent Skills, Obsidian Workflows, Technical Leadership, Tallinn, Portfolio">
	<meta name="author" content="Andrius Shiaulis">
	{noindex && <meta name="robots" content="noindex">}
	<link rel="canonical" href={canonicalURL}>
	<link rel="sitemap" href="/sitemap-index.xml">

	<!-- Open Graph -->
	<meta property="og:title" content={ogTitle}>
	<meta property="og:description" content={description}>
	<meta property="og:site_name" content="Andrius Shiaulis">
	<meta property="og:locale" content="en_US">
	<meta property="og:image" content={imageURL}>
	<meta property="og:image:alt" content={imageAlt}>
	{ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)}>}
	{ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)}>}
	<meta property="og:url" content={canonicalURL}>
	<meta property="og:type" content={type}>
	{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()}>}
	{publishedTime && <meta name="publish_date" property="og:publish_date" content={publishedTime.toISOString()}>}
	{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()}>}
	{type === 'article' && <meta property="article:author" content={new URL('/about/', siteURL).href}>}

	<!-- Twitter Card -->
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:site" content="@shiaulis">
	<meta name="twitter:creator" content="@shiaulis">
	<meta name="twitter:title" content={ogTitle}>
	<meta name="twitter:description" content={description}>
	<meta name="twitter:image" content={imageURL}>
	<meta name="twitter:image:alt" content={imageAlt}>

	<!-- Favicon -->
	<link rel="icon" type="image/svg+xml" href="/favicon.svg">
	<link rel="apple-touch-icon" href="/apple-touch-icon.png">

	{structuredDataJSON && <script type="application/ld+json" set:html={structuredDataJSON} />}

	<!-- Fonts & Icons -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous">
</head>
<body>
	<slot />
</body>
</html>
