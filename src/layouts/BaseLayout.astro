---
import { getImage } from 'astro:assets';
import ogBanner from '../assets/og-banner.png';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	noindex?: boolean;
}

const {
	title = "Andrius Shiaulis | Senior Software Engineer & AI Workflow Advisor",
	description = "Senior Software Engineer and Technical Advisor with 11+ years in tech (Pipedrive, Readdle), helping individuals and teams bring practical AI tools, custom agent workflows, and resilient architecture into daily work.",
	image,
	type = "website",
	noindex = false,
} = Astro.props;

const siteURL = Astro.site ?? new URL('https://telbin.dev');
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const defaultImage = image ? undefined : await getImage({
	src: ogBanner,
	width: 1200,
	height: 630,
	format: 'png',
});
const imageURL = new URL(image ?? defaultImage!.src, siteURL);
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">

	<title>{title}</title>
	<meta name="description" content={description}>
	<meta name="keywords" content="Senior Software Engineer, AI Workflow Advisor, Technical Advisor, Software Architecture, AI Agent Skills, Obsidian Workflows, Technical Leadership, Tallinn, Portfolio">
	<meta name="author" content="Andrius Shiaulis">
	{noindex && <meta name="robots" content="noindex">}
	<link rel="canonical" href={canonicalURL}>
	<link rel="sitemap" href="/sitemap-index.xml">

	<!-- Open Graph -->
	<meta property="og:title" content={title}>
	<meta property="og:description" content={description}>
	<meta property="og:image" content={imageURL}>
	<meta property="og:image:width" content="1200">
	<meta property="og:image:height" content="630">
	<meta property="og:url" content={canonicalURL}>
	<meta property="og:type" content={type}>

	<!-- Twitter Card -->
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content={title}>
	<meta name="twitter:description" content={description}>
	<meta name="twitter:image" content={imageURL}>

	<!-- Favicon -->
	<link rel="icon" type="image/svg+xml" href="/favicon.svg">

	<!-- Fonts & Icons -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous">
</head>
<body>
	<slot />
</body>
</html>
