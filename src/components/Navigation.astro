---
const isAbout = Astro.url.pathname.startsWith('/about');
const isBlog = Astro.url.pathname.startsWith('/blog');
---

<nav aria-label="Primary">
	<div class="nav-left">
		<a href="/" class="nav-brand">telbin<span class="nav-brand-dot">.</span>dev</a>
	</div>

	<div class="nav-right">
		<a href="/about/" class="nav-link" aria-current={isAbout ? 'page' : undefined}>About</a>
		<a href="/blog/" class="nav-link" aria-current={isBlog ? 'page' : undefined}>Blog</a>

		<div class="contact-dropdown">
			<button
				id="contact-trigger"
				type="button"
				class="contact-trigger"
				popovertarget="contact-popover"
				aria-expanded="false"
				aria-controls="contact-popover"
			>
				<span>Contact</span>
				<svg
					class="contact-chev"
					width="14"
					height="14"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M6 9l6 6 6-6"></path>
				</svg>
			</button>

			<div id="contact-popover" class="contact-popover" popover="auto">
				<div class="contact-copy-row">
					<button
						type="button"
						class="contact-item contact-copy-item"
					>
						<span class="contact-item-text">
							<span class="contact-item-label">Email</span>
							<span id="contact-email-value" class="contact-item-value">andrius@telbin.dev</span>
						</span>
						<span class="contact-item-icon" aria-hidden="true">
							<svg
								class="icon-copy"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<rect x="9" y="9" width="11" height="11" rx="2"></rect>
								<path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
							</svg>
							<svg
								class="icon-check"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.4"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path d="M5 12.5l4.5 4.5L19 7.5" pathLength="1"></path>
							</svg>
						</span>
					</button>
					<span class="contact-copy-tip" role="status"></span>
				</div>

				<a
					href="https://linkedin.com/in/shiaulis/"
					target="_blank"
					rel="noopener noreferrer"
					class="contact-item"
				>
					<span class="contact-item-text">
						<span class="contact-item-label">LinkedIn</span>
						<span class="contact-item-value">@shiaulis</span>
					</span>
					<svg
						class="contact-item-icon"
						width="18"
						height="18"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M14 4h6v6"></path>
						<path d="M20 4l-9 9"></path>
						<path d="M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4"></path>
					</svg>
				</a>

				<a
					href="https://github.com/shiaulis"
					target="_blank"
					rel="noopener noreferrer"
					class="contact-item"
				>
					<span class="contact-item-text">
						<span class="contact-item-label">GitHub</span>
						<span class="contact-item-value">@shiaulis</span>
					</span>
					<svg
						class="contact-item-icon"
						width="18"
						height="18"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M14 4h6v6"></path>
						<path d="M20 4l-9 9"></path>
						<path d="M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4"></path>
					</svg>
				</a>
			</div>
		</div>
	</div>
</nav>

<script>
	const trigger = document.getElementById('contact-trigger') as HTMLButtonElement | null;
	const popover = document.getElementById('contact-popover') as HTMLElement | null;

	function positionFallback() {
		if (!trigger || !popover || CSS.supports('position-area', 'block-end')) return;
		const triggerRect = trigger.getBoundingClientRect();
		const popRect = popover.getBoundingClientRect();
		let top = triggerRect.bottom + 8;
		if (top + popRect.height > window.innerHeight - 8) {
			top = Math.max(8, triggerRect.top - popRect.height - 8);
		}
		const left = Math.max(
			8,
			Math.min(triggerRect.right - popRect.width, window.innerWidth - popRect.width - 8)
		);
		popover.style.top = `${top}px`;
		popover.style.left = `${left}px`;
	}

	if (trigger && popover) {
		// The in-page link ("Get in touch") that opened the popover, so focus can go back to it on close.
		let openerLink: HTMLAnchorElement | null = null;
		let restoreFocus = false;

		// Runs before the popover hides: only restore focus if it was still inside the popover
		// (Escape, or a close from within). A click elsewhere has already moved focus, so leave it there.
		popover.addEventListener('beforetoggle', (event) => {
			if ((event as ToggleEvent).newState === 'closed') {
				restoreFocus = openerLink !== null && popover.contains(document.activeElement);
			}
		});

		popover.addEventListener('toggle', (event) => {
			const isOpen = (event as ToggleEvent).newState === 'open';
			trigger.setAttribute('aria-expanded', String(isOpen));
			if (isOpen) {
				positionFallback();
			} else {
				if (restoreFocus) openerLink?.focus({ preventScroll: true });
				openerLink = null;
				restoreFocus = false;
			}
		});

		window.addEventListener('resize', () => {
			if (trigger.getAttribute('aria-expanded') === 'true') {
				positionFallback();
			}
		});

		document.querySelectorAll<HTMLAnchorElement>('a[data-contact-link]').forEach((link) => {
			link.addEventListener('click', (event) => {
				event.preventDefault();
				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				window.scrollTo({ top: 0, behavior: reduceMotion ? 'instant' : 'smooth' });
				if (!popover.matches(':popover-open')) {
					popover.showPopover({ source: trigger } as ShowPopoverOptions);
				}
				// Move focus into the menu so keyboard and VoiceOver users land on its first item.
				// preventScroll keeps the scroll-to-top above from being cut short.
				openerLink = link;
				popover.querySelector<HTMLElement>('.contact-item')?.focus({ preventScroll: true });
			});
		});
	}

	const timers = new WeakMap<HTMLElement, number>();
	let lastMessage = '';

	function report(button: HTMLElement, ok: boolean) {
		const tip = button.nextElementSibling as HTMLElement | null;
		window.clearTimeout(timers.get(button));
		button.removeAttribute('data-copied');
		button.removeAttribute('data-failed');
		let message = ok ? 'Copied' : 'Copy failed';
		if (message === lastMessage) message += '\u00A0';
		lastMessage = message;
		if (tip) tip.textContent = '';
		void button.offsetWidth;
		button.setAttribute(ok ? 'data-copied' : 'data-failed', '');
		requestAnimationFrame(() => {
			if (tip) tip.textContent = message;
		});
		timers.set(
			button,
			window.setTimeout(() => {
				button.removeAttribute('data-copied');
				button.removeAttribute('data-failed');
				if (tip) tip.textContent = '';
			}, 2000)
		);
	}

	const copyButton = document.querySelector<HTMLButtonElement>('.contact-copy-item');
	const email = document.getElementById('contact-email-value');

	copyButton?.addEventListener('click', async () => {
		const text = email?.textContent?.trim();
		if (!text) return;
		try {
			await navigator.clipboard.writeText(text);
			report(copyButton, true);
		} catch {
			report(copyButton, false);
		}
	});
</script>
