---
import { Image } from 'astro:assets';
import heroSketch from '../assets/hero-sketch.jpg';
---

<section class="hero-section">
	<div class="hero-container">
		<div class="hero-avatar">
			<Image
				src={heroSketch}
				alt="Andrius Shiaulis pencil sketch portrait"
				width={240}
				height={240}
				densities={[1, 2]}
				quality={90}
				loading="eager"
				fetchpriority="high"
			/>
		</div>

		<p class="hero-greeting">Hi, it's good to meet you, I'm Andrius Shiaulis. I'm a…</p>

		<h1 class="hero-statement">
			<span class="highlight">Senior Software Engineer</span><br />
			&amp; <span class="highlight">AI Workflow Advisor</span><br />
			helping teams and individuals bring practical AI into daily work
		</h1>

		<p class="hero-sub">11+ years in tech (Pipedrive, Readdle) · Based in Tallinn, Estonia</p>

		<div class="hero-actions">
			<a href="#how-i-help" class="primary-pill">How I can help ↓</a>
			<a href="/about/" class="secondary-pill">About &amp; Experience</a>
			<a href="#contact" class="secondary-pill">Get in touch</a>
		</div>
	</div>
</section>
