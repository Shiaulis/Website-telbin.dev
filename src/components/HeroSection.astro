---
import { Image } from 'astro:assets';
import heroSketch from '../assets/hero-sketch.jpg';
---

<section class="hero-section">
	<div class="hero-container">
		<div class="hero-avatar">
			<Image
				src={heroSketch}
				alt="Andrius Shiaulis pencil sketch portrait"
				width={136}
				height={136}
				densities={[1, 2, 3]}
				loading="eager"
				fetchpriority="high"
			/>
		</div>

		<p class="hero-greeting">Hi, it's good to meet you, I'm Andrius Shiaulis. I'm a…</p>

		<h1 class="hero-statement">
			<span class="highlight">Senior Software Engineer</span><br />
			&amp; <span class="highlight">AI Workflow Advisor</span><br />
			helping teams and individuals bring practical&nbsp;AI into<br />
			daily&nbsp;work
		</h1>

		<p class="hero-sub">11+ years in tech (Pipedrive, Readdle) · Based in Tallinn, Estonia</p>

		<div class="hero-actions">
			<a href="https://fantastical.app/shiaulis/intro-call" class="primary-pill">Book a free 30-min call</a>
			<a href="#how-i-help" class="secondary-pill">How I can help ↓</a>
			<a href="mailto:andrius@telbin.dev" class="secondary-pill" data-contact-link>Get in touch</a>
		</div>
	</div>
</section>
