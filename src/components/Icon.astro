---
// Small inline SVG icons (replaces the Font Awesome web font).
// Icons are decorative: the surrounding link or text carries the meaning.
interface Props {
	name: 'arrow-left' | 'external-link' | 'info' | 'rss';
	class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
	class:list={['icon', className]}
	width="1em"
	height="1em"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{name === 'arrow-left' && (
		<>
			<path d="M19 12H5" />
			<path d="M12 19l-7-7 7-7" />
		</>
	)}
	{name === 'external-link' && (
		<>
			<path d="M14 4h6v6" />
			<path d="M20 4l-9 9" />
			<path d="M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4" />
		</>
	)}
	{name === 'info' && (
		<>
			<circle cx="12" cy="12" r="9" />
			<path d="M12 11v5" />
			<path d="M12 7.5h.01" />
		</>
	)}
	{name === 'rss' && (
		<>
			<path d="M5 11a8 8 0 0 1 8 8" />
			<path d="M5 4a15 15 0 0 1 15 15" />
			<circle cx="6" cy="18" r="1" fill="currentColor" />
		</>
	)}
</svg>
