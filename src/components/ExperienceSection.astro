---
import { experiences } from '../data/experience';
---

<section id="experience" class="experience-section">
	<h2>Experience</h2>
	<div class="timeline">
		{experiences.map((exp) => (
			<div class="experience-group">
				<h3 class="company-name">{exp.company}</h3>
				{exp.positions.map((position) => (
					<div class="position">
						<div class="position-header">
							<h4 class="position-title">{position.title}</h4>
							<span class="position-period">{position.period}</span>
						</div>
						{position.location && (
							<p class="position-location">{position.location}</p>
						)}
						{position.description && (
							<p class="position-description">{position.description}</p>
						)}
						{position.highlights && position.highlights.length > 0 && (
							<ul class="position-highlights">
								{position.highlights.map((highlight) => (
									<li>{highlight}</li>
								))}
							</ul>
						)}
						{position.skills && position.skills.length > 0 && (
							<div class="position-skills">
								{position.skills.map((skill) => (
									<span class="skill-tag">{skill}</span>
								))}
							</div>
						)}
					</div>
				))}
			</div>
		))}
	</div>
</section>
