---
import { experiences } from '../data/experience';
---

<section id="experience" class="experience-section">
	<h2>Experience</h2>
	<div class="timeline">
		{experiences.map((exp) => (
			<div class="experience-group">
				<div class="company-header">
					<h3 class="company-name">{exp.company}</h3>
					<span class="company-meta">{exp.location} · {exp.period}</span>
				</div>

				<div class="position">
					<div class="role-progression">
						{exp.roles.map((role, index) => (
							<>
								{index > 0 && <span class="role-sep" aria-hidden="true">·</span>}
								<span class="role-item">
									<strong class="position-title">{role.title}</strong>
									<span class="position-period">({role.period})</span>
								</span>
							</>
						))}
					</div>

					{exp.description && (
						<p class="position-description">{exp.description}</p>
					)}

					{exp.highlights.length > 0 && (
						<ul class="position-highlights">
							{exp.highlights.map((highlight) => (
								<li>
									{highlight.label && <strong>{highlight.label}: </strong>}
									{highlight.text}
								</li>
							))}
						</ul>
					)}
				</div>
			</div>
		))}
	</div>
</section>
