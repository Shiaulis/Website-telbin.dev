---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import authorPhoto from '../../assets/author-photo.jpg';
import '../../styles/global.css';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
	title={`${post.data.title} | Andrius Shiaulis`}
	description={post.data.description}
	socialTitle={post.data.title}
	image={post.data.image ?? `/og/${post.id}.png`}
	imageAlt={post.data.image ? undefined : `${post.data.title} — blog post by Andrius Shiaulis`}
	imageWidth={post.data.image ? undefined : 1200}
	imageHeight={post.data.image ? undefined : 630}
	type="article"
	publishedTime={post.data.pubDate}
	modifiedTime={post.data.updatedDate}
>
	<Navigation />
	<main>
		<article class="blog-post">
			<header class="post-header">
				<a href="/blog/" class="back-link">
					<Icon name="arrow-left" /> Back to Blog
				</a>
				<h1>{post.data.title}</h1>
				<div class="post-byline">
					<Image
						src={authorPhoto}
						alt=""
						width={44}
						height={44}
						densities={[1, 2]}
						loading="eager"
						class="post-author-avatar"
					/>
					<div>
						<p class="post-author">
							by <a href="/about/" rel="author">Andrius Shiaulis</a>
						</p>
						<p class="post-meta">
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric',
									timeZone: 'UTC'
								})}
							</time>
							{post.data.updatedDate && (
								<span class="updated">
									(Updated: {post.data.updatedDate.toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'long',
										day: 'numeric',
										timeZone: 'UTC'
									})})
								</span>
							)}
						</p>
					</div>
				</div>
				{post.data.tags && post.data.tags.length > 0 && (
					<div class="post-tags">
						{post.data.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
				)}
			</header>

			<div class="post-content">
				<Content />
			</div>
		</article>
	</main>
	<Footer />
</BaseLayout>
