---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import Footer from '../components/Footer.astro';
import { competencies } from '../data/experience';
import '../styles/global.css';
---

<BaseLayout
	title="About | Andrius Shiaulis"
	description="Senior Software Engineer and Technical Advisor with 11+ years in tech (Pipedrive, Readdle) and an earlier background in operations management."
>
	<Navigation />
	<main id="main" class="about-page">
		<section class="about-intro-section">
			<div class="personal-closer">
				<div class="closer-main">
					<div class="closer-text">
						<span class="section-eyebrow">About Me</span>
						<h1 class="about-title">Senior Software Engineer &amp; AI Workflow Advisor</h1>
						<p class="closer-bio">
							I'm a Senior Software Engineer and Technical Advisor with 11+ years in tech (Pipedrive, Readdle) and an earlier background in operations management. Throughout my career, I've loved two things most: diving deep into complex systems to make them simple and reliable, and constantly learning new tools so I can share them with the people around me.
						</p>
						<p class="closer-bio">
							Today, I focus on helping individuals and teams bring practical AI tools, custom agent workflows, and better habits into their everyday work.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="competencies-section">
			<h2>Core Competencies &amp; Skills</h2>
			<ul class="competencies-list">
				{competencies.map((item) => (
					<li>
						<strong>{item.category}: </strong>{item.items}
					</li>
				))}
			</ul>
		</section>

		<ExperienceSection />
	</main>
	<Footer />
</BaseLayout>
